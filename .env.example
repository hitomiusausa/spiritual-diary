# Anthropic API key used by /api/analyze and /api/chat.
# Copy this file to .env.local and set the value locally.
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
# チャットだけ別モデルにする場合(未設定ならCLAUDE_MODEL→claude-haiku-5-5の順)
# KIRI_CLAUDE_MODEL=claude-haiku-5-5

# チャット開発プレビュー。1またはtrueで /api/chat の権利判定をバイパスする(開発専用。
# KIRI_DEPLOY_ENV / VERCEL_ENV が production・preview のときは無視される。未設定なら権利判定はRevenueCatに聞く)。
KIRI_CHAT_PREVIEW=1
# 画面側のプレミアムカードと「開発プレビューでKiriに聞く」ボタンも出すには、これも1にする(ビルド時定数。未設定なら非表示)。
# NEXT_PUBLIC_KIRI_CHAT_PREVIEW=1

# RevenueCat のシークレットキー(v1 REST。sk_...)。/api/chat の購読確認に使う。名前だけ書いておく。
# 値は .env.local ではなく、Cloudflare の Secrets(本番)と .dev.vars(ローカルの workerd。git管理外)に置く(D-19:
# OpenNext は .env* を Worker に埋め込むため)。未設定なら本番のチャットは常に403(購読なし扱い)。
# 使うときは .dev.vars に次の1行を書く:
# REVENUECAT_SECRET_KEY=

# 共有ストア(レート制限・日次クォータのカウンタ。DECISIONS.md D-18参照)
# Upstash Redis(東京リージョン)。Vercel連携で入る KV_REST_API_URL / KV_REST_API_TOKEN でも可。
# 未設定ならプロセス内メモリで動く。本番・プレビュー(VERCEL_ENV=production/preview)で未設定なら
# /api/analyze と /api/chat は503を返す。
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# 公開環境の判定(D-19)。production/preview なら上の共有ストアと下の秘密鍵が必須(欠ければ503)。
# Cloudflare では wrangler.jsonc の vars で production に固定済み。Vercel では VERCEL_ENV でも判定する。
# KIRI_DEPLOY_ENV=production
# IPアドレスをハッシュ化する秘密鍵(32文字以上)。生成例: openssl rand -base64 48
# 開発時に未設定ならプロセス起動ごとのランダム値を使う。本番・プレビューでは必須。
# KIRI_STORE_SECRET=

# API保護の上限(すべて任意。DECISIONS.md D-08, D-18参照)
# RATE_LIMIT_ANALYZE_PER_MIN=10
# RATE_LIMIT_CHAT_PER_MIN=20
# DAILY_LIMIT_ANALYZE=300
# DAILY_LIMIT_CHAT=500
# 購読者ごとの1日のチャット上限(既定60。利用規約・購入画面の「1日60通まで」と揃える)
# KIRI_CHAT_USER_DAILY_LIMIT=60

# iOS静的書き出し用のAPIベースURL。Webビルドでは設定しない(相対URLのまま)。
# ここに書かず、scripts/build-ios.mjs(レーンB)がプロセス環境として渡す。
# NEXT_PUBLIC_KIRI_API_BASE=https://kiri.kugainc.com
