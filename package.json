{
  "name": "spiritual-diary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "cf:build": "node scripts/patch-opennext.mjs && opennextjs-cloudflare build",
    "cf:deploy": "node scripts/check-embedded-env.mjs && opennextjs-cloudflare deploy",
    "cf:upload": "node scripts/check-embedded-env.mjs && opennextjs-cloudflare upload",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && npm run cf:deploy",
    "upload": "npm run cf:build && npm run cf:upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "ios:build": "node scripts/build-ios.mjs",
    "ios:sync": "npm run ios:build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@opennextjs/cloudflare": "1.20.7",
    "@upstash/redis": "^1.39.0",
    "lucide-react": "^0.562.0",
    "lunar-javascript": "^1.7.7",
    "next": "^16.2.11",
    "postcss": "^8.5.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/postcss": "^4",
    "esbuild": "0.27.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "4.143.1"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
