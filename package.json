{
  "name": "spiritual-diary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "cf:build": "node scripts/patch-opennext.mjs && opennextjs-cloudflare build",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "node scripts/check-no-env-files.mjs && npm run cf:build && opennextjs-cloudflare deploy",
    "upload": "node scripts/check-no-env-files.mjs && npm run cf:build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "@upstash/redis": "^1.39.0",
    "lucide-react": "^0.562.0",
    "lunar-javascript": "^1.7.7",
    "next": "^16.2.11",
    "postcss": "^8.5.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "esbuild": "0.27.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "vitest": "^4.1.10",
    "wrangler": "4.143.1"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
