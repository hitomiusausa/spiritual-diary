// Cloudflare Workers 設定（OpenNext: @opennextjs/cloudflare）。DECISIONS.md D-19 参照。
// 秘密（CLAUDE_API_KEY・UPSTASH_REDIS_REST_TOKEN・KIRI_STORE_SECRET など）はここに書かず、
// ダッシュボードの Secrets か `wrangler secret put` で設定する。ローカルは .dev.vars（git管理外）。
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "kiri",
	"compatibility_date": "2026-09-21",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// 公開URLは kiri.kugainc.com だけ（kugainc.com のゾーンは同じアカウント）。workers.dev とプレビューURLは出さない。
	"routes": [
		{ "pattern": "kiri.kugainc.com", "custom_domain": true }
	],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "kiri"
		}
	],
	// 本番判定（src/lib/kiriStore.js の storeReadiness）。デプロイ時の設定漏れを防ぐためコミットで固定する。
	// Redis か KIRI_STORE_SECRET が欠けていれば /api/analyze と /api/chat は503になる。
	// DAILY_LIMIT_ANALYZE: 1日の読み解き回数の上限。ダッシュボードの平文変数はデプロイで上書きされるためここで固定する。
	"vars": {
		"KIRI_DEPLOY_ENV": "production",
		"DAILY_LIMIT_ANALYZE": "30"
	},
	// 運用ログ（console.log/warn/error。日記本文・IP・秘密は出さない実装）だけを残す。
	// 呼び出しログ（invocation logs）はリクエストのメタデータ（接続元など）を含むため無効にする。
	// キーは node_modules/wrangler/config-schema.json の Observability 定義で確認済み。
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		},
		"traces": {
			"enabled": false
		}
	}
}
